<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.5; color: #111827; }
      .container { max-width: 600px; margin: 0 auto; padding: 20px; }
      .card { border: 1px solid #e5e7eb; border-radius: 8px; padding: 20px; background-color: #ffffff; }
      pre { background-color: #f3f4f6; padding: 12px; border-radius: 6px; font-size: 12px; overflow-x: auto; max-height: 350px; }
      .badge { display: inline-block; padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; background: #ecfdf5; color: #065f46; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="card">
        <h2>Bulk Employee Import Complete</h2>
        <p>Hello <strong><%= @user.email %></strong>,</p>
        <p>Your bulk employee import has finished processing. The full <code>import.log</code> has been attached to this email.</p>
        <span class="badge">Import Finished</span>
        <h3>Log Breakdown:</h3>
        <pre><%= @log_content %></pre>
        <p style="font-size: 12px; color: #6b7280; margin-top: 20px;">
          Employee Salary Management System &bull; Automated Solid Queue Notification
        </p>
      </div>
    </div>
  </body>
</html>
